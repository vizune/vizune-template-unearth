---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import LatestReviews from '../components/LatestReviews.astro';
import { getLatestReviews } from '../data/reviews';
import { latest as latestSection } from '../data/site';

// The last slot(s) of the row are "Coming soon" cards (see latest.comingSoon)
const latest = getLatestReviews(latestSection.columns - latestSection.comingSoon);
---

<BaseLayout>
  <Hero reviewCount={latest.length} latestSubject={latest[0]?.subject} />
  <AboutSection />
  <LatestReviews reviews={latest} />
</BaseLayout>
